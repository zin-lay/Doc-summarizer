# ─────────────────────────────────────────────────────────────
# Document Summarizer configuration
# Copy this file to .env and edit. Lines starting with # are ignored.
# ─────────────────────────────────────────────────────────────

# Which model backend to use: ollama | openai | anthropic
#   ollama     = local model, no API key, nothing leaves your machine (default)
#   openai     = any OpenAI-compatible server (LM Studio, vLLM, LocalAI, Azure OpenAI ...)
#   anthropic  = Claude API (requires an API key)
PROVIDER=ollama

# ── Web server ───────────────────────────────────────────────
# 127.0.0.1 = only this computer can open the app (recommended)
# 0.0.0.0   = anyone on your network can open it (set APP_PASSWORD!)
HOST=127.0.0.1
PORT=3000

# Optional login (HTTP Basic Auth). Leave APP_PASSWORD empty to disable.
APP_USER=admin
APP_PASSWORD=

# ── Ollama (PROVIDER=ollama) ─────────────────────────────────
OLLAMA_URL=http://127.0.0.1:11434
# qwen2.5:7b handles English and Japanese well. Alternatives: llama3.1:8b, gemma2:9b, qwen2.5:14b
OLLAMA_MODEL=qwen2.5:7b
# Context window in tokens. Larger = longer documents per request but more RAM/VRAM.
OLLAMA_NUM_CTX=16384

# ── OpenAI-compatible server (PROVIDER=openai) ───────────────
# Works with local servers (LM Studio, vLLM) AND free hosted services.
# Default below is LM Studio. For a fast FREE hosted model, use one of the
# ready-made blocks further down (Groq or OpenRouter) instead.
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_KEY=
OPENAI_MODEL=local-model

# ---- Option: Groq (fast, free, no credit card) --------------
# Get a key at https://console.groq.com  → API Keys. Then set PROVIDER=openai
# above and uncomment these three lines (check the current model list in the
# console; model names change):
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_your-key-here
# OPENAI_MODEL=llama-3.3-70b-versatile

# ---- Option: OpenRouter (many free models) ------------------
# Get a key at https://openrouter.ai/keys. The model name must end in :free
# to stay free. Then set PROVIDER=openai above and uncomment:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-your-key-here
# OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# CONTEXT_TOKENS=32000

# ── Claude API (PROVIDER=anthropic) ──────────────────────────
# Get a key at https://console.anthropic.com  — never commit your real key.
ANTHROPIC_API_KEY=
# Check https://docs.claude.com for current model names.
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Generation (all providers) ───────────────────────────────
MAX_OUTPUT_TOKENS=2048
TEMPERATURE=0.2
# Optional overrides. By default the app works these out from the provider.
# CONTEXT_TOKENS=16384
# MAX_INPUT_CHARS=19660
